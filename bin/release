#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

archive_path=${KEYWINK_ARCHIVE_PATH:-build/release/Keywink.xcarchive}
artifact_dir=${KEYWINK_ARTIFACT_DIR:-build/release/artifacts}

if [[ -z ${KEYWINK_DEVELOPMENT_TEAM:-} ]]; then
  echo "KEYWINK_DEVELOPMENT_TEAM is required (the Apple Developer Team ID)." >&2
  exit 64
fi

if [[ ! $KEYWINK_DEVELOPMENT_TEAM =~ ^[A-Z0-9]{10}$ ]]; then
  echo "KEYWINK_DEVELOPMENT_TEAM must be a 10-character Apple Developer Team ID." >&2
  exit 64
fi

if [[ -z ${KEYWINK_NOTARY_PROFILE:-} ]]; then
  echo "KEYWINK_NOTARY_PROFILE is required (a notarytool Keychain profile)." >&2
  exit 64
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Tracked files must be clean before preparing a release." >&2
  exit 65
fi

bin/archive "$archive_path"

temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/keywink-release.XXXXXX")
trap 'rm -rf "$temporary_dir"' EXIT

export_options="$temporary_dir/ExportOptions.plist"
export_dir="$temporary_dir/export"

cat > "$export_options" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>destination</key>
  <string>export</string>
  <key>method</key>
  <string>developer-id</string>
  <key>signingStyle</key>
  <string>manual</string>
  <key>teamID</key>
  <string>$KEYWINK_DEVELOPMENT_TEAM</string>
</dict>
</plist>
EOF

xcodebuild -exportArchive \
  -archivePath "$archive_path" \
  -exportPath "$export_dir" \
  -exportOptionsPlist "$export_options"

app_path="$export_dir/Keywink.app"
if [[ ! -d $app_path ]]; then
  echo "Export did not produce $app_path" >&2
  exit 66
fi

bundle_id=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$app_path/Contents/Info.plist")
if [[ $bundle_id != de.niklas-heer.Keywink ]]; then
  echo "Expected bundle identifier de.niklas-heer.Keywink, got $bundle_id" >&2
  exit 65
fi

codesign --verify --deep --strict --verbose=2 "$app_path"

notary_upload="$temporary_dir/Keywink-notarization.zip"
ditto -c -k --sequesterRsrc --keepParent "$app_path" "$notary_upload"
xcrun notarytool submit "$notary_upload" \
  --keychain-profile "$KEYWINK_NOTARY_PROFILE" \
  --wait

xcrun stapler staple "$app_path"
xcrun stapler validate "$app_path"
spctl --assess --type execute --verbose "$app_path"

version=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$app_path/Contents/Info.plist")
build=$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$app_path/Contents/Info.plist")
if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || ! $build =~ ^[1-9][0-9]*$ ]]; then
  echo "Refusing to package invalid version $version ($build)." >&2
  exit 65
fi
artifact="$artifact_dir/Keywink-$version-$build.zip"

mkdir -p "$artifact_dir"
if [[ -e $artifact || -e $artifact.sha256 ]]; then
  echo "Release artifact already exists for $version ($build) in $artifact_dir" >&2
  exit 73
fi

ditto -c -k --sequesterRsrc --keepParent "$app_path" "$artifact"
(cd "$artifact_dir" && shasum -a 256 "$(basename "$artifact")" > "$(basename "$artifact").sha256")

# Sparkle appcast with this release only: every installed version updates straight to it.
sparkle_tools=$(find "$repo_root/build/SourcePackages/artifacts/sparkle/Sparkle/bin" \
  "$HOME/Library/Developer/Xcode/DerivedData" -maxdepth 8 -type f -name generate_appcast 2>/dev/null | head -1)
if [[ -z $sparkle_tools ]]; then
  echo "Sparkle's generate_appcast was not found; run mise run build first." >&2
  exit 69
fi
sparkle_tools=$(dirname "$sparkle_tools")
sparkle_account=${KEYWINK_SPARKLE_ACCOUNT:-ed25519}
mkdir -p "$temporary_dir/appcast"
cp "$artifact" "$temporary_dir/appcast/"
"$sparkle_tools/generate_appcast" --account "$sparkle_account" \
  --download-url-prefix "https://github.com/niklas-heer/Keywink/releases/download/v$version/" \
  --link "https://github.com/niklas-heer/Keywink/releases/tag/v$version" \
  -o "$artifact_dir/appcast.xml" "$temporary_dir/appcast"
"$sparkle_tools/sign_update" --account "$sparkle_account" --verify "$artifact" \
  "$(sed -n 's/.*sparkle:edSignature="\([^"]*\)".*/\1/p' "$artifact_dir/appcast.xml" | head -1)"

echo "Prepared notarized GitHub release artifacts:"
echo "  $artifact"
echo "  $artifact.sha256"
echo "  $artifact_dir/appcast.xml"
echo "Publish all three as release assets; installed apps read the newest release's appcast.xml."
