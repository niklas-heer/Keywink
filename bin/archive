#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

archive_path=${1:-build/release/Keywink.xcarchive}
signing_identity=${KEYWINK_SIGNING_IDENTITY:-Developer ID Application}
# Updates come from the newest GitHub release's appcast asset; the public key is safe to publish.
update_feed_url=${KEYWINK_UPDATE_FEED_URL-https://github.com/niklas-heer/Keywink/releases/latest/download/appcast.xml}
update_public_key=${KEYWINK_UPDATE_PUBLIC_KEY-SL638YLPjJQuUkrCa0p26d1nfMoa69+ymt0mzNQDscA=}

if [[ -z ${KEYWINK_DEVELOPMENT_TEAM:-} ]]; then
  echo "KEYWINK_DEVELOPMENT_TEAM is required (the Apple Developer Team ID)." >&2
  exit 64
fi

if [[ ! $KEYWINK_DEVELOPMENT_TEAM =~ ^[A-Z0-9]{10}$ ]]; then
  echo "KEYWINK_DEVELOPMENT_TEAM must be a 10-character Apple Developer Team ID." >&2
  exit 64
fi

if [[ -e $archive_path ]]; then
  echo "Archive already exists: $archive_path" >&2
  echo "Move or remove it before creating a new release archive." >&2
  exit 73
fi

mkdir -p "$(dirname "$archive_path")"

xcodebuild archive \
  -project "Keywink.xcodeproj" \
  -scheme "Keywink" \
  -configuration Release \
  -destination "generic/platform=macOS" \
  -archivePath "$archive_path" \
  DEVELOPMENT_TEAM="$KEYWINK_DEVELOPMENT_TEAM" \
  CODE_SIGN_STYLE=Manual \
  CODE_SIGN_IDENTITY="$signing_identity" \
  KEYWINK_UPDATE_FEED_URL="$update_feed_url" \
  KEYWINK_UPDATE_PUBLIC_KEY="$update_public_key"

echo "Created $archive_path"
